# KRX 정보데이터시스템 (data.krx.co.kr) 회원 계정 — pykrx 시점별 시총/종목 조회용
# 무료 회원가입: https://data.krx.co.kr → 우상단 회원가입. 데이터 백테스트(유니버스) 작업에 필요.
KRX_ID=
KRX_PW=

# 한국투자증권 (KIS) Open API — KOSPI
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ENV=paper            # paper | real

# Alpaca — NASDAQ
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# DART OpenAPI (금융감독원 전자공시) — KOSPI 실적/재무 (PEAD 전략)
# 무료 발급: https://opendart.fss.or.kr 회원가입 → 이메일 인증 → 인증키 신청
DART_API_KEY=

# Engine API
API_HOST=0.0.0.0
API_PORT=8000

# Dashboard
VITE_API_BASE_URL=http://localhost:8000
